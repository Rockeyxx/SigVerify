# Project-specific exclusions
*.db
*.sqlite
*.sqlite3
/data/
/datasets/
models/weights/
*.pth
*.pt

# Security — never commit keys
*.key
*.pem

# Planning docs (local only, not repo content)
docs/*

# Understand-Anything knowledge graph: the data lives in the local docs folder and
# .ua is a symlink to it. No trailing slash: git sees a symlink as a file.
.ua

# EGM design briefs, drafts and review reports (local only)
.egm/
.vibe-wise/

# Local diagnostics — instruments for answering "why is this number bad",
# not project code. Nothing imports them and nothing ships with them, so they
# stay out of the repo; their findings live in docs/ENG_REPORT.md.
tools/diagnose_error_sources.py

# One-off evaluation arms from 2026-08-18/19. Each answered a single question,
# the answer is recorded, and nothing imports them. Kept on
# disk for reference, out of the repo for the same reason as the line above.
# (fusion_paired_eval.py is deliberately NOT here: its +5.07-point result is the
# open lever, and it gets re-run the moment paired capture exists.)
tools/enroll_augment_eval.py
tools/per_user_norm_eval.py
tools/scoring_variants_eval.py
tools/user_threshold_eval.py
tools/diagnose_synthesis_gap.py
tests/test_enroll_augment.py
tests/test_user_threshold.py
tests/test_diagnose_synthesis_gap.py

# Logs
*.log
logs/

#graphy
graphify-out/

# Skylos
# The CI action and a local `skylos .` both write the report into the repo root.
# The config in .skylos/ IS tracked; the generated report is not.
skylos-report.json
.skylos/cache/

src/gui/data/
src/gui/ui/
src/gui/test_verification_ui.py
cropped_test/
desktop.ini