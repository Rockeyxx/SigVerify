# Local diagnostics — instruments for answering "why is this number bad",
# not project code. Nothing imports them and nothing ships with them, so they
# stay out of the repo; their findings live in docs/SOLUTIONS.md.
tools/diagnose_error_sources.py

# One-off evaluation arms from 2026-08-18/19. Each answered a single question,
# the answer is recorded in SUMMARY.md Part 9, and nothing imports them. Kept on
# disk for reference, out of the repo for the same reason as the line above.
# (fusion_paired_eval.py is deliberately NOT here: its +5.07-point result is the
# open lever, and it gets re-run the moment paired capture exists.)
tools/enroll_augment_eval.py
tools/per_user_norm_eval.py
tools/scoring_variants_eval.py
tools/user_threshold_eval.py
tools/diagnose_synthesis_gap.py
tests/test_enroll_augment.py
tests/test_user_threshold.py
tests/test_diagnose_synthesis_gap.py

